{
  "name": "portfoligus",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["shared", "frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @portfolio/backend",
    "dev:web": "npm run dev --workspace @portfolio/frontend",
    "build": "npm run build --workspace @portfolio/frontend && npm run build --workspace @portfolio/backend",
    "start:api": "npm run start --workspace @portfolio/backend",
    "preview": "npm run preview --workspace @portfolio/frontend",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
