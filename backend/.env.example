# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env
PORT=4000
NODE_ENV=development

# origin ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย comma ถ้ามีหลายอัน)
CORS_ORIGINS=http://localhost:5173

# ที่เก็บข้อความจากฟอร์มติดต่อ
CONTACT_STORE=./data/messages.jsonl

# จำกัดจำนวนครั้งที่ส่งฟอร์มได้ ต่อ IP ต่อช่วงเวลา
CONTACT_RATE_WINDOW_MINUTES=15
CONTACT_RATE_MAX=5
